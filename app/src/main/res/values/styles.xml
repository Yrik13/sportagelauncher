<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CardBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">#FF141A26</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="CardLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#FF8A93A5</item>
        <item name="android:letterSpacing">0.15</item>
    </style>

    <style name="CardValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">#FF3FB9E8</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
