<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0E13">

    <!-- Часы слева сверху -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="64sp"
            android:textColor="#FF3FB9E8"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#FF8A93A5" />
    </LinearLayout>

    <!-- Температура за бортом справа сверху -->
    <TextView
        android:id="@+id/outdoorTemp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:textSize="32sp"
        android:textColor="#FF3FB9E8"
        android:text="12°" />

    <!-- Центральные цифры: обороты и скорость -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="48dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/rpmValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="48sp"
                android:textColor="#FFFFFFFF"
                android:text="2120" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#FF8A93A5"
                android:text="ОБ/МИН" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="48dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/speedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="48sp"
                android:textColor="#FFFFFFFF"
                android:text="0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#FF8A93A5"
                android:text="КМ/Ч" />
        </LinearLayout>
    </LinearLayout>

    <!-- Нижняя панель данных -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:orientation="horizontal">

        <LinearLayout style="@style/CardBox" android:layout_weight="1">
            <TextView style="@style/CardLabel" android:text="ТОПЛИВО" />
            <TextView android:id="@+id/fuelValue" style="@style/CardValue" android:text="37.2 л" />
        </LinearLayout>

        <LinearLayout style="@style/CardBox" android:layout_weight="1">
            <TextView style="@style/CardLabel" android:text="ОЖ" />
            <TextView android:id="@+id/coolantValue" style="@style/CardValue" android:text="90°C" />
        </LinearLayout>

        <LinearLayout style="@style/CardBox" android:layout_weight="1">
            <TextView style="@style/CardLabel" android:text="АКБ" />
            <TextView android:id="@+id/batteryValue" style="@style/CardValue" android:text="14.1 В" />
        </LinearLayout>

        <LinearLayout style="@style/CardBox" android:layout_weight="1">
            <TextView style="@style/CardLabel" android:text="ПЕРЕДАЧА" />
            <TextView android:id="@+id/gearValue" style="@style/CardValue" android:text="D" />
        </LinearLayout>
    </LinearLayout>

    <!-- Сетка приложений (скрыта до нажатия кнопки) -->
    <ScrollView
        android:id="@+id/appsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#CC0B0E13">

        <GridLayout
            android:id="@+id/appGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="6"
            android:padding="16dp" />
    </ScrollView>

    <!-- Кнопка: панель ↔ приложения -->
    <Button
        android:id="@+id/toggleBtn"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:background="#33FFFFFF"
        android:text="▦"
        android:textSize="24sp"
        android:textColor="#FFFFFFFF" />
</FrameLayout>

       
              
       
